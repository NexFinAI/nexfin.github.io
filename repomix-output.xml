            <div key={i} className="text-mist">
              {line.text}
            </div>
          )
        })}
        <div>
          <span className="select-none text-signal">$&nbsp;</span>
          <span
            aria-hidden
            className={cx(
              'inline-block h-[15px] w-[8px] translate-y-[3px]',
              'animate-blink bg-signal/80',
