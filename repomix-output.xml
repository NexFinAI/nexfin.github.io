@import "tailwindcss";

/* ------------------------------------------------------------------
   NexfinAI design tokens — "machine room" palette
   Green-phosphor terminal aesthetic: near-black green-tinted base,
   hairline green edges, matrix-green signal accent, amber reserved
   for future / in-progress semantics.
------------------------------------------------------------------- */
@theme {
  --font-sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI",
    Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas,
    "Liberation Mono", monospace;

  --color-base: #020604;      /* page background        */
  --color-panel: #060d09;     /* card / panel surface   */
  --color-panel-2: #0a1510;   /* raised surface         */
  --color-edge: #123227;      /* hairline borders       */
  --color-mist: #7f9a8d;      /* muted text             */
  --color-fog: #c2d8cc;       /* secondary text         */
  --color-signal: #00ff88;    /* matrix green accent    */
  --color-flag: #e8b34b;      /* roadmap accent (amber) */

  --animate-blink: blink 1.1s step-end infinite;

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
}

@layer base {
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 5.5rem;
    -webkit-text-size-adjust: 100%;
    scrollbar-color: #14402e #020604;
    scrollbar-width: thin;
  }

  body {
    background-color: var(--color-base);
    color: var(--color-fog);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: clip;
  }

  h1, h2, h3, h4 {
    color: #ffffff;
  }

  ::selection {
    background-color: rgba(0, 255, 136, 0.3);
    color: #02140c;
  }
}

::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: #020604; }
::-webkit-scrollbar-thumb {
  background: #14402e;
  border-radius: 0;
  border: 2px solid #020604;
}
::-webkit-scrollbar-thumb:hover { background: #1d5c42; }

/* ---------------- CRT / scanlines ---------------- */
.scanlines {
  background: repeating-linear-gradient(
    0deg,
    rgba(0, 0, 0, 0.28) 0px,
    rgba(0, 0, 0, 0.28) 1px,
    transparent 1px,
    transparent 3px
  );
  animation: crt 6s ease-in-out infinite;
}
@keyframes crt {
  0%, 100% { opacity: 0.42; }
  50% { opacity: 0.52; }
}

/* Soft phosphor glow for headings / wordmark */
.glow-soft {
  text-shadow: 0 0 18px rgba(0, 255, 136, 0.28);
}
.glow-text {
  text-shadow: 0 0 34px rgba(0, 255, 136, 0.45);
}

/* ---------------- Scroll reveal ---------------- */
.reveal {
  opacity: 0;
  transform: translateY(16px);
  transition:
    opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
    transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity, transform;
}
.reveal.is-visible {
  opacity: 1;
  transform: none;
}

/* ---------------- Hero figure (SVG) ---------------- */
.hv-flow-dotted {
  stroke-dasharray: 0.1 7;
  stroke-linecap: round;
  animation: hv-dash-dotted 2.4s linear infinite;
}
@keyframes hv-dash-dotted { to { stroke-dashoffset: -28.4; } }

.hv-flow-teal {
  stroke-dasharray: 6 9;
  animation: hv-dash-teal 1.8s linear infinite;
}
@keyframes hv-dash-teal { to { stroke-dashoffset: -30; } }

.hv-pulse-ring {
  transform-box: fill-box;
  transform-origin: center;
  animation: hv-ring 2.8s ease-out infinite;
}
@keyframes hv-ring {
  0%   { transform: scale(0.5); opacity: 0.8; }
  100% { transform: scale(2.2); opacity: 0; }
}

/* glyph rain columns inside the figure */
.hv-rain-a { animation: hv-rain 11s linear infinite; }
.hv-rain-b { animation: hv-rain 17s linear infinite; }
@keyframes hv-rain {
  from { transform: translateY(-260px); }
  to   { transform: translateY(500px); }
}

/* ticker tape */
.hv-ticker { animation: hv-ticker 22s linear infinite; }
@keyframes hv-ticker { to { transform: translateX(-560px); } }

.hv-label {
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: 1.6px;
  fill: #7f9a8d;
}
.hv-comment {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 1.2px;
  fill: rgba(0, 255, 136, 0.55);
}
.hv-glyph {
  font-family: var(--font-mono);
  font-size: 12px;
  fill: rgba(0, 255, 136, 0.5);
}

/* ---------------- Pipeline / methodology rail ---------------- */
.rail-dot { animation: rail-run 5.5s linear infinite; }
@keyframes rail-run {
  0%   { left: -2%;  opacity: 0; }
  8%   { opacity: 1; }
  92%  { opacity: 1; }
  100% { left: 102%; opacity: 0; }
}

/* ---------------- Reduced motion ---------------- */
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }

  *,
  *::before,
  *::after {
    animation-duration: 0.001s !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001s !important;
  }

  .reveal {
    opacity: 1 !important;
    transform: none !important;
  }

  .scanlines { animation: none; opacity: 0.42; }
}
</file>

